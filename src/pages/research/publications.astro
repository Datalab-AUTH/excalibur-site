---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import ScrollReveal from "../../components/ScrollReveal.tsx";
import { Icon } from "astro-icon/components";
import { SITE } from "../../config/site.mjs";
---

<Layout
  title={`Publications | ${SITE.title}`}
  description="Browse scientific publications, papers, and research outputs from the EXCALIBUR project."
  canonicalURL={`${SITE.url}/research/publications`}
>
  <Header />
  <main id="main-content" role="main">
    <div class="panel panel--white relative overflow-hidden" style="background-image: url('/images/banner6.webp'); background-size: cover; background-position: center bottom;">
      <!-- Semi-transparent overlay for readability -->
      <div class="absolute inset-0 bg-[#0b1a4a]/50 z-0"></div>
      <section class="relative z-10 max-w-4xl mx-auto px-4 py-20">
        <ScrollReveal client:idle>
          <h1 class="text-5xl font-bold text-white mb-4 text-center">Publications</h1>
        </ScrollReveal>
        <ScrollReveal client:load delay={0.1}>
          <p class="text-xl text-gray-100 mb-12">
            Scientific papers, conference proceedings, and research outputs from the EXCALIBUR project.
          </p>
        </ScrollReveal>
      </section>
    </div>
    <div class="panel panel--sand">
      <section class="max-w-4xl mx-auto px-4 py-20">
        <ScrollReveal client:load delay={0.2}>
          <article class="bg-white border border-gray-200 rounded-lg p-8 shadow-sm">
            <div class="flex items-start gap-4">
              <div class="w-12 h-12 bg-blue-50 rounded-lg flex items-center justify-center shrink-0">
                <Icon name="tabler:file-text" class="w-6 h-6 text-blue-700" aria-hidden="true" />
              </div>
              <div>
                <p class="text-sm font-semibold text-blue-700 uppercase tracking-wide mb-2">Journal Article</p>
                <h2 class="text-2xl font-bold text-gray-900 mb-3">
                  KFS-TUNE: Kernel-based Feature Selection for efficiency and accuracy tuning in Time Series Classification
                </h2>
                <p class="text-gray-700 mb-3">
                  Vei, S., Tiakas, E., &amp; Vakali, A.
                </p>
                <p class="text-gray-600 mb-2">
                  <span class="font-semibold text-gray-800">Knowledge-Based Systems</span>, Volume 349, Article 116523, 2026.
                </p>
                <p class="text-gray-600 mb-6">
                  DOI:
                  <a
                    href="https://doi.org/10.1016/j.knosys.2026.116523"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-blue-700 hover:text-blue-900 underline underline-offset-2"
                  >
                    10.1016/j.knosys.2026.116523
                  </a>
                </p>
                <a
                  href="https://www.sciencedirect.com/science/article/pii/S0950705126012499"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-2 bg-blue-700 text-white px-5 py-3 rounded-lg font-semibold hover:bg-blue-800 transition-colors"
                >
                  View publication
                  <Icon name="tabler:external-link" class="w-5 h-5" aria-hidden="true" />
                </a>
              </div>
            </div>
          </article>
        </ScrollReveal>


      </section>
    </div>
  </main>
  <Footer />
</Layout>
